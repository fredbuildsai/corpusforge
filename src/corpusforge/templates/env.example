# Copy to .env and fill in. Never commit .env.

# Storage (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db).
# Relative sqlite paths resolve against the project directory (the current working directory).
# CF_DATABASE_URL=sqlite:///data/corpus.db

# Polite-crawling contact (sent in the User-Agent to OpenAlex, Crossref, Unpaywall, arXiv, ...)
CF_CONTACT_EMAIL=
# Identity in that User-Agent
# CF_APP_NAME=corpusforge
# HuggingFace tokenizer used to size chunks (read from the local HF cache; falls back to a word estimate)
# CF_TOKENIZER_MODEL=unsloth/gemma-4-E2B-it

# Router spend guard for paid models
CF_ALLOW_PAID=false
CF_MAX_USD_PER_DAY=5

# LLM providers (read by LiteLLM; leave blank to disable a provider - see configs/llm_routes.yaml)
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=            # any non-empty value enables the local Ollama deployment

# Data sources (all optional)
OPENALEX_API_KEY=
CORE_API_KEY=              # free at core.ac.uk/services/api; raises the anonymous rate limit for full-text lookups
